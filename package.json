{
  "name": "remember-me",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "tsc -p jsconfig.json",
    "lint": "node scripts/check.mjs && prettier --check .",
    "build": "node scripts/build.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
